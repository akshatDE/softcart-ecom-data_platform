# Template for platforms/snowflake/.env — copy to .env and fill in. This file IS tracked.
# Find the host on the Snowflake Postgres instance page (Snowsight -> Postgres).
PG_HOST=
PG_PORT=5432
PG_DATABASE=postgres
PG_SCHEMA=softcart
PG_USER=
PG_PASSWORD=

# Snowflake account (for Snowpark / snowsql use outside a notebook)
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_ROLE=ACCOUNTADMIN
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=SNOWFLAKE_LEARNING_DB
SNOWFLAKE_SCHEMA=ECOMM_SCHEMA
